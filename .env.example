# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nafis-flowers

# NextAuth v4
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-bcrypt-password-hash

# Public canonical URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional checkout notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ORDER_NOTIFICATION_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
