# MongoDB Atlas (production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/floraluxe
# Local replica set example:
# MONGODB_URI=mongodb://127.0.0.1:27017/floraluxe?replicaSet=rs0

# NextAuth v4
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-bcrypt-password-hash

# Public canonical URL. Use the same HTTPS origin as NEXTAUTH_URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reliable Telegram order notifications. The bot must already belong to the target group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protects the Vercel Cron retry endpoint. Use at least 32 random characters.
CRON_SECRET=
